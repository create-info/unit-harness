{
  "name": "unit-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:constraints": "node scripts/check-constraints.mjs",
    "uh": "node packages/cli/src/main.ts",
    "build:native": "bash scripts/build-native.sh",
    "prepare": "node scripts/build.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "@tauri-apps/cli": "^2.0.0"
  },
  "bin": {
    "uh": "dist/uh.cjs",
    "unitai": "dist/uh.cjs"
  },
  "files": [
    "dist/uh.cjs",
    "dist/bin/",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ]
}
